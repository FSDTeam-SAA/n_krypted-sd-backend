            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": \"{{restaurant_id}}\",\n  \"dishId\": \"{{dish_id}}\",\n  \"rating\": 5,\n  \"comment\": \"SD editorial review\",\n  \"status\": \"active\"\n}"
            }
          }
        },
        {
          "name": "Update Any Review",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/admin/reviews/{{review_id}}",
            "description": "Admin can edit any review. If the target is a customer review, override metadata is recorded.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Admin adjusted review text\",\n  \"status\": \"active\",\n  \"overrideReason\": \"Moderation correction\"\n}"
            }
          }
        },
        {
          "name": "Override Customer Review",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/admin/reviews/{{review_id}}/override",
            "description": "Explicit endpoint for admin overriding a customer review. Stores originalReview, overriddenBy, overriddenAt, and overrideReason.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 3,\n  \"comment\": \"Admin adjusted customer review\",\n  \"overrideReason\": \"Moderation correction\"\n}"
            }
          }
        },
        {
          "name": "Update Review Status",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
