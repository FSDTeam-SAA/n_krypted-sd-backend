{
  "info": {
    "name": "n_krypted MVP API",
    "description": "Modular API documentation for the n_krypted customer app, restaurant-owner app, and admin dashboard screens. All responses return German in message for frontend display and English in messageEn for developer/debug clarity.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "customer_token", "value": "" },
    { "key": "customer_refresh_token", "value": "" },
    { "key": "owner_token", "value": "" },
    { "key": "owner_refresh_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "admin_refresh_token", "value": "" },
    { "key": "otp", "value": "" },
    { "key": "reset_token", "value": "" },
    { "key": "restaurant_id", "value": "" },
    { "key": "dish_id", "value": "" },
    { "key": "review_id", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "gallery_image_id", "value": "" },
    { "key": "cloudinary_public_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth & Profile",
      "description": "Onboarding, sign up, OTP verification, sign in, access/refresh token, forgot password, profile, password, and account deletion screens. Store accessToken in *_token variables and refreshToken in *_refresh_token variables.",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/register",
            "description": "Creates a customer account for the mobile app.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer User\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"customer\",\n  \"phone\": \"+8801700000000\"\n}"
            }
          }
        },
        {
          "name": "Register Owner With Pending Restaurant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/register",
            "description": "Creates a restaurant-owner account and a restaurant profile with status pending until admin approval.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Owner User\",\n  \"email\": \"owner@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"restaurant_owner\",\n  \"phone\": \"+8801700000001\",\n  \"restaurant\": {\n    \"name\": \"Restaurant JAN\",\n    \"email\": \"restaurant@example.com\",\n    \"phone\": \"+8801700000002\",\n    \"address\": \"Munich, Germany\",\n    \"description\": \"Modern German food\",\n    \"categories\": [\"German\", \"Popular\"],\n    \"priceRange\": \"$$\",\n    \"location\": {\n      \"type\": \"Point\",\n      \"coordinates\": [90.4125, 23.8103]\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "Register First Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/register",
            "description": "Creates the first admin account only. Further public admin registrations are blocked.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "Sign in screen. Requires verified email. Returns accessToken/token and refreshToken. Store accessToken in customer_token, owner_token, or admin_token depending on role.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Verify Signup OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/verify-email",
            "description": "OTP screen after sign up. Verifies email and returns accessToken/token plus refreshToken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"otp\": \"{{otp}}\"\n}"
            }
          }
        },
        {
          "name": "Resend Signup OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/resend-verification-otp",
            "description": "Resends the email verification OTP for the sign-up OTP screen.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\"\n}"
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/refresh-token",
            "description": "Uses refreshToken to rotate and return a new accessToken/token plus new refreshToken. Frontend should replace both stored tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{customer_refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password - Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/forgot-password",
            "description": "Forgot Password screen. Sends OTP to email through Gmail SMTP.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password - Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/verify-password-reset-otp",
            "description": "OTP screen for forgot password. Returns resetToken for the Change password screen.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"otp\": \"{{otp}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password - Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/reset-password",
            "description": "Change password screen after forgot-password OTP verification. Clears old refresh token sessions.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"resetToken\": \"{{reset_token}}\",\n  \"newPassword\": \"newpassword123\"\n}"
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/me",
            "description": "Used by customer and owner profile screens. Owner responses include restaurant when present."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [],
            "url": "{{base_url}}/api/v1/auth/me",
            "description": "Used by Edit Profile screens. Supports multipart/form-data with avatar file, or JSON without a file.",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "type": "text", "value": "Updated Name" },
                { "key": "phone", "type": "text", "value": "+8801711111111" },
                { "key": "avatar", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/change-password",
            "description": "Used by logged-in Change Password screens. Clears old refresh token sessions after password change.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newpassword123\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/logout",
            "description": "Clears the stored refresh token for the current user. Frontend should also remove local access/refresh tokens."
          }
        },
        {
          "name": "Delete My Account",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/auth/me",
            "description": "Soft deletes the logged-in account for Account Management and Delete Account screens."
          }
        }
      ]
    },
    {
      "name": "Customer - Home/Search/Map",
      "description": "Home feed, restaurant list, filters, categories, and map screens.",
      "item": [
        {
          "name": "List Restaurants",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/restaurants?page=1&limit=10&search=Restaurant&category=German&priceRange=$$&district=Munich&openNow=false&minRating=4&sort=rating",
            "description": "Used by Home, Search, Restaurants, Filter, and Categories screens. Returns active restaurants only. If bearer token is sent, restaurants include isSaved."
          }
        },
        {
          "name": "Nearby Restaurants",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/restaurants/nearby?lat=23.8103&lng=90.4125&radius=5000&page=1&limit=10&category=German&priceRange=$$&district=Munich&openNow=false&sort=distance",
            "description": "Used by Map and Track Yourself screens. Uses lat/lng/radius and MongoDB geospatial search. If bearer token is sent, restaurants include isSaved."
          }
        },
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/categories",
            "description": "Returns restaurant categories, dish categories, and a merged category list."
          }
        }
      ]
    },
    {
      "name": "Customer - Restaurant & Dish Details",
      "description": "Restaurant details, dish details, signature dishes, all dishes, and view tracking.",
      "item": [
        {
          "name": "Restaurant Details",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/restaurants/{{restaurant_id}}",
            "description": "Used by Restaurants details screen. Includes restaurant, signatureDishes, and dishes. If bearer token is sent, restaurant/dishes include isSaved."
          }
        },
        {
          "name": "Restaurant Dishes",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/restaurants/{{restaurant_id}}/dishes?page=1&limit=20&signatureOnly=false",
            "description": "Used by Signature Dishes and All dishes screens."
          }
        },
        {
          "name": "Dish Details",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/dishes/{{dish_id}}",
            "description": "Used by Dish details screens. Includes dish, restaurant, and relatedDishes. If bearer token is sent, dish/restaurant include isSaved."
          }
        },
        {
          "name": "Record Restaurant View",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "POST",
            "url": "{{base_url}}/api/v1/restaurants/{{restaurant_id}}/views",
            "description": "Records a profile/detail view for owner Viewers and admin metrics. Auth is optional."
          }
        }
      ]
    },
    {
      "name": "Customer - Saved/Reviews/Check-ins",
      "description": "Saved list, review list/create, your review, check-in, and engagement flows.",
      "item": [
        {
          "name": "List Reviews",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/reviews?restaurantId={{restaurant_id}}&dishId={{dish_id}}&reviewType=customer&page=1&limit=10",
            "description": "Used by Reviews and Dish details screens. dishId and reviewType are optional. reviewType can be customer or sd_admin."
          }
        },
        {
          "name": "List My Reviews",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/v1/me/reviews?page=1&limit=10",
            "description": "Used by profile/my activity screens if the user needs to manage their own reviews."
          }
        },
        {
          "name": "Create Review",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/v1/reviews",
            "description": "Used by Your review screen. Customer must check in to the restaurant before creating this review. Supports multipart/form-data with images files, or JSON with image asset objects. Recalculates customer rating aggregates.",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "restaurantId", "type": "text", "value": "{{restaurant_id}}" },
                { "key": "dishId", "type": "text", "value": "{{dish_id}}" },
                { "key": "rating", "type": "text", "value": "5" },
                { "key": "comment", "type": "text", "value": "Excellent food and service." },
                { "key": "images", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Update My Review",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [],
            "url": "{{base_url}}/api/v1/reviews/{{review_id}}",
            "description": "Lets a customer edit only their own review. Supports multipart/form-data images or JSON without files.",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "rating", "type": "text", "value": "4" },
                { "key": "comment", "type": "text", "value": "Updated review text." },
                { "key": "images", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Delete My Review",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/reviews/{{review_id}}",
            "description": "Soft deletes only the authenticated customer's own review and recalculates ratings."
          }
        },
        {
          "name": "List Saved Items",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/v1/me/saved",
            "description": "Used by Saved screen."
          }
        },
        {
          "name": "Save Restaurant",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/me/saved",
            "description": "Idempotent save action for restaurant heart/bookmark buttons.",
            "body": { "mode": "raw", "raw": "{\n  \"itemType\": \"restaurant\",\n  \"id\": \"{{restaurant_id}}\"\n}" }
          }
        },
        {
          "name": "Save Dish",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/me/saved",
            "description": "Idempotent save action for dish heart/bookmark buttons.",
            "body": { "mode": "raw", "raw": "{\n  \"itemType\": \"dish\",\n  \"id\": \"{{dish_id}}\"\n}" }
          }
        },
        {
          "name": "Remove Saved Item",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/me/saved/restaurant/{{restaurant_id}}",
            "description": "Use /restaurant/:id or /dish/:id depending on item type."
          }
        },
        {
          "name": "Create Check-in",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/restaurants/{{restaurant_id}}/check-ins",
            "description": "Used by Check in and Track Yourself screens.",
            "body": { "mode": "raw", "raw": "{\n  \"lat\": 23.8103,\n  \"lng\": 90.4125\n}" }
          }
        }
      ]
    },
    {
      "name": "Restaurant Owner",
      "description": "Owner home, profile, inside places, dishes, reviews, viewers, check-ins, and rating analytics screens.",
      "item": [
        {
          "name": "Owner Dashboard",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{owner_token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/v1/owner/dashboard",
            "description": "Used by owner Home screen."
          }
        },
        {
          "name": "Create Restaurant Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{owner_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/owner/restaurant",
            "description": "Creates a pending restaurant profile when the owner did not provide one during registration.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Restaurant JAN\",\n  \"email\": \"restaurant@example.com\",\n  \"phone\": \"+8801700000002\",\n  \"address\": \"Munich, Germany\",\n  \"description\": \"Modern German food\",\n  \"categories\": [\"German\"],\n  \"location\": {\n    \"type\": \"Point\",\n    \"coordinates\": [90.4125, 23.8103]\n  }\n}"
            }
          }
        },
        {
          "name": "Get Owner Restaurant",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{owner_token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/v1/owner/restaurant",
            "description": "Used by owner profile and restaurant details editing screens."
          }
        },
        {
          "name": "Update Owner Restaurant",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{owner_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/owner/restaurant",
            "description": "Updates owner restaurant details, location, categories, and opening hours.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Restaurant JAN\",\n  \"address\": \"Munich, Germany\",\n  \"categories\": [\"German\", \"Signature\"],\n  \"openingHours\": [\n    { \"day\": \"Monday\", \"open\": \"09:00\", \"close\": \"21:00\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Upload Restaurant Gallery",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{owner_token}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/v1/owner/restaurant/gallery",
            "description": "Used by Inside places screens. Send multipart form-data with one or more images under key images.",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "images", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Delete Restaurant Gallery Image",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{owner_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/owner/restaurant/gallery/{{gallery_image_id}}",
            "description": "Deletes a gallery item from the restaurant and Cloudinary."
          }
        },
        {
          "name": "Reorder Restaurant Gallery",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{owner_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/owner/restaurant/gallery/reorder",
            "description": "Reorders inside-place/gallery images. Any gallery images not included stay after the submitted order.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderedImageIds\": [\"{{gallery_image_id}}\"]\n}"
            }
          }
        },
        {
          "name": "List Owner Dishes",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{owner_token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/v1/owner/dishes?page=1&limit=20&search=Schnitzel",
            "description": "Used by Signature Dishes, All dishes, and dish management screens."
          }
        },
        {
          "name": "Create Owner Dish",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{owner_token}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/v1/owner/dishes",
            "description": "Used by add/edit dish screens. Supports multipart/form-data with images files, or JSON with image asset objects.",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "type": "text", "value": "Schnitzel" },
                { "key": "description", "type": "text", "value": "Crispy signature dish" },
                { "key": "price", "type": "text", "value": "15.45" },
                { "key": "category", "type": "text", "value": "Main" },
                { "key": "ingredients", "type": "text", "value": "Chicken,Breadcrumbs" },
                { "key": "preparationMethod", "type": "text", "value": "Pan-fried until golden." },
                { "key": "isSignature", "type": "text", "value": "true" },
                { "key": "status", "type": "text", "value": "active" },
                { "key": "images", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Get Owner Dish",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{owner_token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/v1/owner/dishes/{{dish_id}}",
            "description": "Used by owner dish detail/edit screens."
          }
        },
        {
          "name": "Update Owner Dish",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{owner_token}}", "type": "string" }] },
