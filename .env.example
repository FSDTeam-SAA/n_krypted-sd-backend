PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/n_krypted
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_SECRET=replace_with_a_long_random_access_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_a_long_random_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=30d
OTP_EXPIRES_IN_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=15
# Keep false on hosts that block SMTP. Set true only after configuring a working email provider.
REQUIRE_EMAIL_VERIFICATION=false
GMAIL_SMTP_USER=your_gmail_address@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_gmail_app_password
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional public social links returned by /api/content/app-settings
INSTAGRAM_URL=
TIKTOK_URL=
